package views

import (
	"fmt"
)

// BoardPage renders the board view with columns and task cards.
templ BoardPage(s Shell, projectID string, columns []ColumnView, swimlanes []SwimlaneRow) {
	@Base(s) {
		<div class="bc-board" id="board-{ projectID }" x-data="board({projectID: '{ projectID }'})">
			<div class="bc-board-toolbar">
				<h2>Board</h2>
				<button
					class="bc-btn bc-btn-sm"
					hx-get={ templ.URL("/app/project/"+projectID+"/board/columns") }
					hx-target="#board-{ projectID }"
				>Configure columns</button>
			</div>

			<div class="bc-board-columns" role="region" aria-label="Board columns" aria-live="polite" aria-atomic="false" aria-relevant="additions removals">
			for _, col := range columns {
				<div class="bc-board-column" id="col-{ col.ID }" data-status={ col.Status } style={ fmt.Sprintf("--col-color: %s", col.Color) }>
					<div class="bc-col-header">
						<h3 class="bc-col-name">{ col.Name }</h3>
						<span class="bc-col-count">{ fmt.Sprintf("%d", col.Count) }</span>
						if col.WIPLimit > 0 {
							<span class="bc-col-wip" if col.Count > col.WIPLimit { class="bc-col-wip-over" }>
								WIP { fmt.Sprintf("%d/%d", col.Count, col.WIPLimit) }
							</span>
						}
					</div>

					<div class="bc-col-cards" id="col-cards-{ col.ID }">
						for _, c := range col.Cards {
							<div class="bc-card" data-sort-key={ c.ID }>
								<div class="bc-card-key">{ c.Key }</div>
								<div class="bc-card-title">{ c.Title }</div>
								<div class="bc-card-meta">
									<div class="bc-card-assignees">
										for _, a := range c.Assignees {
											<span class="bc-avatar bc-avatar-sm" title={ a.Name }>{ a.Initial }</span>
										}
									</div>
									<div class="bc-card-labels">
										for _, l := range c.Labels {
											<span class="bc-pill bc-label-sm" style={ fmt.Sprintf("background-color: %s", l.Color) }>{ l.Name }</span>
										}
									</div>
									if c.Points > 0 {
										<span class="bc-card-points">{ fmt.Sprintf("%d", c.Points) }</span>
									}
								</div>
							</div>
						}
					</div>

						<div class="bc-col-actions">
							<button
								class="bc-btn bc-btn-sm bc-btn-primary"
								hx-get={ templ.URL("/api/project/"+projectID+"/task/new?column="+col.ID) }
							>+ Add</button>
						</div>
					</div>
				}
			</div>

			if len(swimlanes) > 0 {
				<div class="bc-swimlanes">
					<h3>Swimlanes</h3>
					for _, s := range swimlanes {
						<div class="bc-swimlane">
							<h4>{ s.Name }</h4>
							<div class="bc-swimlane-columns">
								for _, col := range s.Columns {
									<div class="bc-swimlane-card">
										{ col.Title }
									</div>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

// ColumnView is a board column with its cards.
type ColumnView struct {
	ID       string
	Name     string
	Color    string
	Status   string
	Count    int
	WIPLimit int
	Cards    []CardView
}

// CardView is a task card on the board.
type CardView struct {
	ID        string
	Key       string
	Title     string
	Points    int
	Assignees []AssigneeRow
	Labels    []LabelRow
}

// SwimlaneRow is a swimlane group.
type SwimlaneRow struct {
	Name    string
	Columns []struct {
		Title string
		Key   string
	}
}

// ColumnSettingsPage renders the column configuration UI.
templ ColumnSettingsPage(s Shell, projectID string, columns []ColumnView) {
	@Base(s) {
		<div class="bc-column-settings" id="col-settings-{ projectID }">
			<h2>Board Columns</h2>
			<form
				hx-post="/api/action/board.column.create"
				hx-headers={ hxHeaders(s.CSRF) }
				hx-target="#col-list"
				hx-swap="beforeend"
				class="bc-form"
			>
				<input type="hidden" name="project_id" value={ projectID }/>
				<input type="hidden" name="status" value="backlog"/>
				<label>Name
					<input type="text" name="name" required class="bc-input"/>
				</label>
				<label>Color
					<input type="color" name="color" value="#6366f1" class="bc-input"/>
				</label>
				<label>WIP Limit
					<input type="number" name="wip_limit" value="0" min="0" class="bc-input"/>
				</label>
				<button type="submit" class="bc-btn bc-btn-primary">Add Column</button>
			</form>

			<div id="col-list">
				for _, col := range columns {
					<div class="bc-col-settings-row" id="col-{ col.ID }">
						<span>{ col.Name }</span>
						<span class="bc-col-count">{ fmt.Sprintf("%d cards", col.Count) }</span>
						<button
							class="bc-btn bc-btn-sm bc-btn-danger"
							hx-post="/api/action/board.column.delete"
							hx-headers={ hxHeaders(s.CSRF) }
							hx-vals={ templ.URL(`{"id":"`+col.ID+`","project_id":"`+projectID+`"}`,) }
							hx-target="#col-{ col.ID }"
							hx-swap="outerHTML"
						>Delete</button>
					</div>
				}
			</div>
		</div>
	}
}

// BoardColumnsPartial renders just the columns and cards area (no shell) for
// SSE-driven partial refresh.
templ BoardColumnsPartial(projectID string, columns []ColumnView, swimlanes []SwimlaneRow) {
	<div class="bc-board-columns" role="region" aria-label="Board columns" aria-live="polite" aria-atomic="false" aria-relevant="additions removals">
	for _, col := range columns {
		<div class="bc-board-column" id="col-{ col.ID }" data-status={ col.Status } style={ fmt.Sprintf("--col-color: %s", col.Color) }>
			<div class="bc-col-header">
				<h3 class="bc-col-name">{ col.Name }</h3>
				<span class="bc-col-count">{ fmt.Sprintf("%d", col.Count) }</span>
				if col.WIPLimit > 0 {
					<span class="bc-col-wip" if col.Count > col.WIPLimit { class="bc-col-wip-over" }>
						WIP { fmt.Sprintf("%d/%d", col.Count, col.WIPLimit) }
					</span>
				}
			</div>

			<div class="bc-col-cards" id="col-cards-{ col.ID }">
				for _, c := range col.Cards {
					<div class="bc-card" data-sort-key={ c.ID }>
						<div class="bc-card-key">{ c.Key }</div>
						<div class="bc-card-title">{ c.Title }</div>
						<div class="bc-card-meta">
							<div class="bc-card-assignees">
								for _, a := range c.Assignees {
									<span class="bc-avatar bc-avatar-sm" title={ a.Name }>{ a.Initial }</span>
								}
							</div>
							<div class="bc-card-labels">
								for _, l := range c.Labels {
									<span class="bc-pill bc-label-sm" style={ fmt.Sprintf("background-color: %s", l.Color) }>{ l.Name }</span>
								}
							</div>
							if c.Points > 0 {
								<span class="bc-card-points">{ fmt.Sprintf("%d", c.Points) }</span>
							}
						</div>
					</div>
				}
			</div>

			<div class="bc-col-actions">
				<button
					class="bc-btn bc-btn-sm bc-btn-primary"
					hx-get={ templ.URL("/api/project/"+projectID+"/task/new?column="+col.ID) }
				>+ Add</button>
			</div>
		</div>
	}
	</div>
	if len(swimlanes) > 0 {
		<div class="bc-swimlanes">
			<h3>Swimlanes</h3>
			for _, s := range swimlanes {
				<div class="bc-swimlane">
					<h4>{ s.Name }</h4>
					<div class="bc-swimlane-columns">
						for _, col := range s.Columns {
							<div class="bc-swimlane-card">{ col.Title }</div>
						}
					</div>
				</div>
			}
		</div>
	}
}
