package views

// Base is the app shell layout: header, desktop sidebar, mobile bottom nav +
// drawer, and a main slot filled by { children... }. All script tags carry
// the per-request CSP nonce from Shell.Nonce.
templ Base(s Shell) {
	<!DOCTYPE html>
	<html lang="en-AU">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.Title } · Boardchestrator</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="manifest" href="/manifest.json"/>
			<link rel="canonical" href="https://boardchestrator.com{ s.Path }"/>
			if s.Description != "" {
				<meta name="description" content={ s.Description }/>
				<meta property="og:title" content={ s.Title }/>
				<meta property="og:description" content={ s.Description }/>
				<meta property="og:type" content="website"/>
				<meta property="og:url" content="https://boardchestrator.com{ s.Path }"/>
				<meta property="og:site_name" content="Boardchestrator"/>
				<meta name="twitter:card" content="summary"/>
			}
			<link rel="stylesheet" href={ templ.URL(s.Assets.AppCSS) }/>
			// Nonced theme bootstrap: applies the persisted theme before first
			// paint so a dark-theme user never sees a light flash. The only
			// inline script permitted by SPEC §15.
			<script nonce={ s.Nonce }>
				(function () {
					try {
						var t = localStorage.getItem("bc-theme");
						if (t === "dark" || t === "light") {
							document.documentElement.setAttribute("data-theme", t);
						}
					} catch (e) { /* storage unavailable: fall back to prefers-color-scheme */ }
				})();
			</script>
		</head>
		<body hx-boost="true" x-data="shell" hx-headers={ hxHeaders(s.CSRF) } data-sw-url={ templ.URL(s.Assets.SW) }>
			<a class="bc-skip-link" href="#main">Skip to content</a>
			<header class="bc-header">
				<button
					class="bc-icon-btn bc-drawer-btn"
					type="button"
					aria-label="Open navigation menu"
					aria-expanded="false"
					aria-controls="drawer-panel"
					x-on:click="openDrawer"
					x-bind:aria-expanded="drawerOpen"
				>
					<span aria-hidden="true" class="bc-ico">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
					</span>
				</button>
				<span class="bc-brand">Boardchestrator</span>
				<button
					class="bc-icon-btn"
					type="button"
					aria-label="Toggle colour theme"
					x-on:click="toggleTheme"
				>
					<span aria-hidden="true" class="bc-ico">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><path d="M12 3a6 6 0 0 0 0 12 6 6 0 0 0 0-12zM12 15v4M12 3V1M12 15v3M9 17h6"/></svg>
					</span>
				</button>
			</header>
			<div class="bc-shell">
				<nav class="bc-sidebar" aria-label="Primary">
					@navLinks(s.Active, false)
				</nav>
				<main id="main" class="bc-main" tabindex="-1">
					{ children... }
				</main>
			</div>
			<nav class="bc-bottom-nav" aria-label="Primary">
				@navLinks(s.Active, true)
			</nav>
			<div class="bc-drawer" x-show="drawerOpen" x-cloak>
				<div class="bc-drawer-backdrop" x-on:click="closeDrawer"></div>
				<nav class="bc-drawer-panel" id="drawer-panel" aria-label="Primary" tabindex="-1">
					@navLinks(s.Active, false)
				</nav>
			</div>
			<script src={ templ.URL(s.Assets.HTMX) } nonce={ s.Nonce } defer></script>
			// app.js registers Alpine components on alpine:init, so it must
			// execute before Alpine (defer preserves this order).
			<script src={ templ.URL(s.Assets.AppJS) } nonce={ s.Nonce } defer></script>
			<script src={ templ.URL(s.Assets.Alpine) } nonce={ s.Nonce } defer></script>
			<script src={ templ.URL(s.Assets.Sortable) } nonce={ s.Nonce } defer></script>
			@HelpDialog()
			// PWA service worker registration. Reads the SW URL from
			// data-sw-url on <body> so templ can interpolate it.
			<script nonce={ s.Nonce }>
				if ("serviceWorker" in navigator) {
					var swURL = document.body.getAttribute("data-sw-url");
					if (swURL) {
						navigator.serviceWorker.register(swURL).catch(function () { /* registration failed — app still works */ });
					}
				}
			</script>
		</body>
	</html>
}

// navLinks renders the primary navigation; mobileOnly restricts to the five
// bottom-nav destinations.
templ navLinks(active string, mobileOnly bool) {
	for _, it := range navItems {
		if !mobileOnly || it.Mobile {
			<a
				class="bc-nav-link"
				href={ templ.URL(it.Href) }
				if it.Href == active {
					aria-current="page"
				}
			>
				if it.Href == "/notifications" {
					{ it.Label }
					<span id="notif-badge" class="bc-notif-badge" x-text="unreadCount > 0 ? unreadCount : ''" style="display:none">0</span>
				} else {
					{ it.Label }
				}
			</a>
		}
	}
}

// Home is the placeholder main-slot content served at /app until real pages
// arrive in later WUs.
templ Home(s Shell) {
	@Base(s) {
		<h1>Welcome to Boardchestrator</h1>
		<p>The app shell is up. Boards, backlog, chat and search arrive in later work units.</p>
	}
}
