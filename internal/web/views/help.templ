package views

// HelpDialog renders the keyboard shortcuts help dialog overlay.
// Triggered by ? key in app.js.
templ HelpDialog() {
	<div
		id="help-dialog"
		class="bc-dialog"
		role="dialog"
		aria-labelledby="help-title"
		aria-modal="true"
		x-show="helpOpen"
		x-cloak
	>
		<div class="bc-dialog-backdrop" x-on:click="helpOpen = false"></div>
		<div class="bc-dialog-panel">
			<h2 id="help-title">Keyboard shortcuts</h2>
			<div class="bc-help-shortcuts">
				<dl>
					<dt><kbd>?</kbd></dt><dd>Open this help dialog</dd>
					<dt><kbd>Esc</kbd></dt><dd>Close dialog / cancel</dd>
					<dt><kbd>Ctrl+K</kbd></dt><dd>Open command palette (search)</dd>
					<dt><kbd>n</kbd></dt><dd>New task (on board/backlog pages)</dd>
					<dt><kbd>g</kbd> then <kbd>b</kbd></dt><dd>Go to board</dd>
					<dt><kbd>g</kbd> then <kbd>l</kbd></dt><dd>Go to backlog</dd>
					<dt><kbd>g</kbd> then <kbd>c</kbd></dt><dd>Go to chat</dd>
					<dt><kbd>g</kbd> then <kbd>s</kbd></dt><dd>Go to search</dd>
					<dt><kbd>g</kbd> then <kbd>n</kbd></dt><dd>Go to notifications</dd>
				</dl>
				<h3>Board</h3>
				<dl>
					<dt><kbd>→</kbd> / <kbd>←</kbd></dt><dd>Next / previous column (mobile focus mode)</dd>
					<dt><kbd>Enter</kbd></dt><dd>Open card (when card is focused)</dd>
					<dt><kbd>Space</kbd></dt><dd>Pick card for move (grab)</dd>
					<dt><kbd>Esc</kbd></dt><dd>Release card (drop)</dd>
					<dt><kbd>↑</kbd> / <kbd>↓</kbd></dt><dd>Move to previous / next column (while grabbed)</dd>
				</dl>
			</div>
			<button
				class="bc-btn bc-btn-primary"
				x-on:click="helpOpen = false"
			>Close</button>
		</div>
	</div>
}
