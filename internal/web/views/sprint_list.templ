package views

import (
	"fmt"
)

// SprintListRow is a single sprint in the list view.
type SprintListRow struct {
	ID        string
	Name      string
	StartsOn  string
	EndsOn    string
	State     string
	TaskCount int
}

// SprintListPage renders the sprint management page for a project.
templ SprintListPage(s Shell, projectID string, sprints []SprintListRow) {
	@Base(s) {
		<div class="bc-sprint-list" id="sprint-list-{ projectID }">
			<h2>Sprints</h2>
			<div class="bc-sprint-actions">
				<button
					class="bc-btn bc-btn-primary"
					hx-get={ templ.URL("/app/org/"+projectID+"/sprints/new") }
				>+ New Sprint</button>
			</div>
			<div id="sprint-list-items">
				for _, spr := range sprints {
					<div class="bc-sprint-row" id="sprint-{ spr.ID }">
						<div class="bc-sprint-name">{ spr.Name }</div>
						<div class="bc-sprint-dates">
							{ spr.StartsOn } – { spr.EndsOn }
						</div>
						<div class="bc-sprint-state">{ spr.State }</div>
						<div class="bc-sprint-count">{ fmt.Sprintf("%d tasks", spr.TaskCount) }</div>
						<div class="bc-sprint-actions-row">
							<button
								class="bc-btn bc-btn-sm"
								hx-get={ templ.URL("/app/org/"+projectID+"/sprints/"+spr.ID+"/edit") }
							>Edit</button>
							<button
								class="bc-btn bc-btn-sm bc-btn-danger"
								hx-post="/api/action/sprint.close"
								hx-headers={ hxHeaders(s.CSRF) }
								hx-vals={ templ.URL(`{"id":"`+spr.ID+`","project_id":"`+projectID+`"}`) }
								hx-target="#sprint-list"
								hx-swap="outerHTML"
							>Close</button>
						</div>
					</div>
				}
			</div>
			if len(sprints) == 0 {
				<p class="bc-empty-state">No sprints yet.</p>
			}
		</div>
	}
}
