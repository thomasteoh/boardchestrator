package views

// OrgSCIMURL is the SCIM token form target for orgID.
func OrgSCIMURL(orgID string) string {
	return OrgSSOURL(orgID) + "/scim-tokens"
}

// OrgSCIMTokenRow is one SCIM token (never the secret).
type OrgSCIMTokenRow struct {
	ID         string
	Name       string
	Prefix     string
	Status     string // active, expired or revoked
	Created    string
	Expires    string
	LastUsed   string
	RevokeOpen bool
}

// OrgSCIMData is the "SCIM provisioning" section.
type OrgSCIMData struct {
	OrgID   string
	CSRF    string
	BaseURL string
	Tokens  []OrgSCIMTokenRow
	// NewToken is a token just created, shown this once ("" = none).
	NewToken     string
	NewTokenName string
}

// OrgSCIMSection lists SCIM tokens, creates (showing the token once) and
// revokes them, and shows the SCIM base URL to paste into the IdP.
templ OrgSCIMSection(d OrgSCIMData) {
	<p class="bc-muted">Your identity provider can create, update and deactivate people in this organisation and keep their groups in sync over SCIM 2.0. Deactivating someone removes their memberships here and revokes their API keys for this organisation. Groups feed the group mappings above (mappings for all providers).</p>
	<dl class="bc-dl">
		<dt>SCIM base URL</dt>
		<dd><code class="bc-copyable" id="scim-base-url">{ d.BaseURL }</code></dd>
		<dt>Authentication</dt>
		<dd>Bearer token (a SCIM token below)</dd>
	</dl>
	if d.NewToken != "" {
		<div class="bc-callout" role="status">
			<p><strong>Copy the token for { d.NewTokenName } now.</strong> It won't be shown again. Paste it into your identity provider as the secret token.</p>
			<p><code class="bc-copyable" id="scim-new-token">{ d.NewToken }</code></p>
			<button type="button" class="bc-btn bc-btn-sm" data-bc-copy="scim-new-token">Copy token</button>
		</div>
	}
	if len(d.Tokens) == 0 {
		<p class="bc-empty-state">No SCIM tokens yet.</p>
	} else {
		<table class="bc-table" aria-label="SCIM tokens">
			<thead>
				<tr><th scope="col">Name</th><th scope="col">Token</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Expires</th><th scope="col">Last used</th><th scope="col"><span class="bc-sr-only">Actions</span></th></tr>
			</thead>
			<tbody>
				for _, t := range d.Tokens {
					<tr>
						<td>{ t.Name }</td>
						<td><code>{ "bcscim_" + t.Prefix + "_…" }</code></td>
						<td>
							switch t.Status {
								case "active":
									<span class="bc-badge">Active</span>
								case "expired":
									<span class="bc-badge bc-badge-muted">Expired</span>
								default:
									<span class="bc-badge bc-badge-muted">Revoked</span>
							}
						</td>
						<td>{ t.Created }</td>
						<td>
							if t.Expires == "" {
								Never
							} else {
								{ t.Expires }
							}
						</td>
						<td>
							if t.LastUsed == "" {
								Never
							} else {
								{ t.LastUsed }
							}
						</td>
						<td>
							if t.RevokeOpen {
								<form method="post" action={ templ.SafeURL(OrgSCIMURL(d.OrgID) + "/" + t.ID + "/revoke") } class="bc-inline-form" hx-boost="false">
									<input type="hidden" name="csrf_token" value={ d.CSRF }/>
									<button type="submit" class="bc-btn bc-btn-sm bc-btn-danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	<form method="post" action={ templ.SafeURL(OrgSCIMURL(d.OrgID)) } class="bc-form bc-form-wide" hx-boost="false">
		<input type="hidden" name="csrf_token" value={ d.CSRF }/>
		<label>
			Token name
			<input type="text" name="name" required maxlength="100" placeholder="Microsoft Entra ID" autocomplete="off" class="bc-input"/>
		</label>
		<label>
			Expires
			<select name="expires_in_days" class="bc-input">
				<option value="0">Never</option>
				<option value="90">In 90 days</option>
				<option value="180">In 180 days</option>
				<option value="365" selected>In a year</option>
				<option value="730">In two years</option>
			</select>
		</label>
		<div class="bc-form-actions">
			<button type="submit" class="bc-btn bc-btn-primary">Create SCIM token</button>
		</div>
	</form>
}
